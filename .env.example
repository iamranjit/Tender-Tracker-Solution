# Copy to .env and fill in. Never commit .env.

# Database (optional; default is SQLite at data/tender_tracker.db)
# DATABASE_URL=postgresql+psycopg2://tracker:password@db:5432/tenders

# Email (SMTP). Gmail: smtp.gmail.com, port 587, and an App Password (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_FROM=GeM Tracker <you@example.com>
# Used if notifications.email_to in config.yaml is empty (comma separated)
EMAIL_TO=

# Telegram: create a bot with @BotFather, send it a message, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack incoming webhook (optional)
SLACK_WEBHOOK_URL=

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX


# AI drafting for proposal workspaces (Claude). Get a key at https://console.anthropic.com
# Only if your key is not scoped to a workspace: Console -> Settings -> Workspaces -> copy the ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=